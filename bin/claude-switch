#!/usr/bin/env bash
# Switches the Claude Code account of the whole machine, from any folder.
#
# Only the account changes: the login in ~/.claude/.credentials.json and the account in
# ~/.claude.json. There is one ~/.claude, so the configuration, rules, MCP servers and their logins,
# sessions and memory stay as they are. Never use CLAUDE_CONFIG_DIR for this: it splits all of that, and
# the rules load twice.
#
# Each account is one file in ~/.claude-accounts. It holds the login, so only you can read it.
#
# The accounts that are not active stay signed in through `claude-switch refresh`, which the
# claude-switch-refresh timer runs at boot and every 4 hours. claude refreshes each of them in a
# folder of its own where no session runs, and the rotated login comes back to its file. That renews
# the login, not the sign-in: only a new sign-in moves the date a sign-in ends, so that is announced.
#
# claude.ai in Chrome follows a switch when the companion in ~/.local/share/claude-switch is installed:
# its extension swaps the claude.ai session cookies, see chrome-host.py there. Claude Desktop follows too,
# through desktop.py there, once it is closed.
#
# With claude-switch auto on, the machine goes to the best account with room by itself: the
# claude-switch-watch timer checks every 5 minutes while a session is open, and a StopFailure hook in
# ~/.claude/settings.json moves the machine as soon as a session meets a limit, then wakes that session.
# usage.py in ~/.local/share/claude-switch reads what each account has left and ranks them.

set -euo pipefail
shopt -s nullglob
umask 077

CREDENTIALS=$HOME/.claude/.credentials.json
CONFIG=$HOME/.claude.json
SETTINGS=$HOME/.claude/settings.json
STORE=$HOME/.claude-accounts
CHROME_HOST=$HOME/.local/share/claude-switch/chrome-host.py
DESKTOP_HELPER=$HOME/.local/share/claude-switch/desktop.py
USAGE_HELPER=$HOME/.local/share/claude-switch/usage.py
SELF=$(readlink -f "$0")
# When this run started: a hook tells by it whether its session failed before the last switch.
STARTED=$(date +%s%3N)

# Automatic switching is on while this file is there.
AUTO_FLAG=$STORE/.auto
# The account a switch typed by hand holds while automatic switching is on, until it runs out.
HOLD=$STORE/.hold
# The order the kinds of account rank in, see claude-switch auto order, and the one with no such file.
ORDER_FILE=$STORE/.auto-order
DEFAULT_ORDER="ultra key max"
# When the last switch happened, in milliseconds.
SWITCHED=$STORE/.switched
# What the automatic switches did and what claude-switch said meanwhile: a hook's stderr goes to Claude.
AUTO_LOG=$STORE/.auto.log
WATCH_TIMER=claude-switch-watch.timer
# What Claude Code passes to the StopFailure hook of claude-switch. A budget comes back as unknown.
HOOK_MATCHER="rate_limit|billing_error|authentication_failed|unknown"
# A hook entry of claude-switch in settings.json, whatever path it was installed at.
# A hook of claude-switch, here or installed elsewhere before: a command line that ends in " hook", or, as Windows
# writes it, a program with arguments whose last one is hook.
OWN_HOOK='any(.hooks[]?; (.command | strings | endswith(" hook") and contains("claude-switch"))
    or ((.args | arrays | last == "hook") and any((.command, .args[]) | strings; contains("claude-switch"))))'

# A login with a token in it. claude empties both tokens when the server refuses a refresh.
SIGNED_IN='.claudeAiOauth.accessToken | type == "string" and length > 0'

# What belongs to the account in .credentials.json: what claude's own logout deletes with the login
# (2.1.314). mcpOAuth and the rest never move.
LOGIN_KEYS='["claudeAiOauth", "designOauth", "cloudSessionsOauth", "organizationUuid", "trustedDeviceToken",
    "trustedDeviceEnrolledAfterRefusalAtMs", "enterpriseGateway"]'
PICK_LOGIN="with_entries(select((.key | IN($LOGIN_KEYS[])) and .value != null))"
DROP_LOGIN="with_entries(select(.key | IN($LOGIN_KEYS[]) | not))"

# What claude itself clears in .claude.json when the account changes. It fetches them again.
DROP_CACHES='del(.managedSettingsNoticeSeenOrg, .additionalModelOptionsCache,
    .additionalModelOptionsAnsweredAt, .additionalModelCostsCache, .modelAccessCache,
    .orgModelDefaultCache, .cachedArtifactRoster, .artifactRosterDenied, .lastSeenOrgDefaultUpdatedAt,
    .clientDataCache, .clientDataCacheSlots, .autoCompactWindowsCache, .cachedUsageUtilization,
    .metricsStatusCache, .metricsStatusCacheByPrincipal, .githubWebConnectionStatusCache,
    .unusedLimitResetStatusCache, .startupPrefetchedAt)'

# A gateway key account is the set of these entries in the env of ~/.claude/settings.json: a token there
# goes before the claude.ai login, and the model names and the URL belong to the gateway. A switch
# replaces all of them, the other entries of env stay.
KEY_ENV='["ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_API_KEY", "ANTHROPIC_BASE_URL", "ANTHROPIC_MODEL",
    "ANTHROPIC_SMALL_FAST_MODEL", "ANTHROPIC_DEFAULT_HAIKU_MODEL", "ANTHROPIC_DEFAULT_SONNET_MODEL",
    "ANTHROPIC_DEFAULT_OPUS_MODEL", "ANTHROPIC_CUSTOM_HEADERS"]'
# The gateway entries of an env that hold a value. claude takes an empty one as unset, and a switch leaves
# "" in place of an entry it takes out: a running session takes in an entry that changes, but keeps one
# that is gone.
KEY_SET="with_entries(select((.key | IN($KEY_ENV[])) and .value != \"\"))"
# After KEY_SET: the token, which claude takes before the claude.ai login, and what a gateway knows its key
# by, the token or else the headers of a gateway that takes the key there.
KEY_TOKEN='(.ANTHROPIC_AUTH_TOKEN // .ANTHROPIC_API_KEY // "")'
KEY_CREDENTIAL='(.ANTHROPIC_AUTH_TOKEN // .ANTHROPIC_API_KEY // .ANTHROPIC_CUSTOM_HEADERS // "")'

# A stored access token with less than this left is refreshed. The timer runs every 4 hours.
REFRESH_AHEAD_MS=$((270 * 60 * 1000))
# A sign-in that ends within this is announced.
WARN_AHEAD_MS=$((3 * 24 * 3600 * 1000))
# A sign-in that ends within this is reminded of by list, the prompt and a switch.
REMIND_AHEAD_MS=$((7 * 24 * 3600 * 1000))

LOCKS=()
# The files this run is writing aside, which only it may remove.
WRITING=()
SIGNIN=""
STUB=""
DEAD=0
# Set while claude-switch switches on its own: Desktop restarts without a question.
AUTO=""
# Set when Claude Desktop stayed on its account because it runs this, one of its Code sessions for instance.
DESKTOP_KEPT=""
# The account the last route went to, and why, for the hook.
ROUTED_TO=""
ROUTED_WHY=""
# What each account has left, by file, for list and the prompt.
declare -A LEFT_OF=()
# Set while claude.ai in Chrome is on the account of a sign-in rather than on the live one.
WEB_AWAY=""

cleanup() {
    [ -z "$STUB" ] || finish_stub "$STUB" || true
    release_locks
    [ -z "$SIGNIN" ] || rm -rf "$SIGNIN"
    # Another run may be writing its own under the same names, so only what this one was writing.
    [ "${#WRITING[@]}" -eq 0 ] || rm -f "${WRITING[@]}"
    [ -z "$WEB_AWAY" ] || web_back
}
trap cleanup EXIT
# systemd stops the service with a TERM: exit through cleanup, which keeps a login already rotated.
trap 'exit 143' TERM INT HUP

usage() {
    cat <<'EOF'
Usage:
  claude-switch                          Prompt to switch, add or rename.
  claude-switch NAME                     Switch the whole machine to NAME, a name or an email.
  claude-switch list                     Print the accounts and what each has left. * marks the active one.
  claude-switch login [ACCOUNT] [OPTIONS]
                                         Sign in an account and keep it here. It doesn't switch.
                                         With ACCOUNT, a name or an email already here, it renews
                                         that one: claude.ai in Chrome goes to it first and the sign-in
                                         page asks for its email. OPTIONS go to claude auth login.
  claude-switch key import NAME          Keep the gateway key now in ~/.claude/settings.json as the
                                         account NAME: its token, URL and model names.
  claude-switch key add NAME [--like KEY] [--api-key] [--base-url URL] [--env VAR=VALUE]...
                                         Keep a gateway key as the account NAME. The token is asked
                                         without echo, or read from the standard input. --like takes
                                         the URL and model names of KEY, --api-key sends the token as
                                         an Anthropic API key, x-api-key, rather than a bearer token.
  claude-switch key renew NAME           Give the gateway key NAME a new token, asked the same way.
  claude-switch key remove NAME          Forget the gateway key NAME, and take it out of
                                         ~/.claude/settings.json when it is active.
  claude-switch rename NAME NEW_NAME     Rename an account.
  claude-switch refresh [--force]        Refresh the login of the accounts that are not active.
                                         The claude-switch-refresh timer runs it at boot and every
                                         4 hours. --force refreshes them even when not due.
  claude-switch auto [on|off]            Turn automatic switching on or off, or say how it stands.
                                         On, the machine goes to the best account with room: every 5
                                         minutes while a session is open, and as soon as a session
                                         meets a limit, which then carries on by itself.
  claude-switch auto order [KIND...]     Say which kind of account comes first, or print the order. A
                                         KIND is ultra, a subscription with no 5-hour limit, max, Max
                                         and the other plans, or key, an API or gateway key. Those left
                                         out follow in the order ultra, key, max.
  claude-switch help                     Print this help, as -h and --help do.

A switch changes the account only, wherever you call it. New sessions start on it and running
sessions move to it at their next request. claude.ai in Chrome follows it too, once the companion
extension in ~/.local/share/claude-switch/chrome-extension is loaded in Chrome. Claude Desktop
follows it as well: an open Desktop is restarted when you answer yes in a terminal.

A switch to a gateway key puts its entries in the env of ~/.claude/settings.json, a switch to a
claude.ai account empties them again, which running sessions follow too. claude.ai in Chrome and
Claude Desktop stay on their account.

A sign-in lasts about 28 days, and only a new sign-in moves its end. From 7 days before, list, the
prompt and a switch say when it ends, with the claude-switch login that renews it.

The best account with room is an Ultra subscription first, then a key, then another plan, unless
claude-switch auto order says otherwise: only the weekly limit counts. An account that stops a session
waits until its limit resets. A switch typed by hand stays while automatic switching is on, until that
account runs out.

Don't use /logout on an account you want to keep: it revokes the login saved here too.
To forget an account, remove its file in ~/.claude-accounts, or a gateway key with claude-switch key
remove NAME.
EOF
}

die() {
    printf 'claude-switch: %s\n' "$*" >&2
    exit 1
}

warn() {
    printf 'claude-switch: %s\n' "$*" >&2
}

trim() {
    local text=$1
    text=${text#"${text%%[![:space:]]*}"}
    printf '%s' "${text%"${text##*[![:space:]]}"}"
}

# The file of the account in a .claude.json. Fails when it holds no account.
account_file() {
    local id
    id=$(jq -er '.oauthAccount | select(.emailAddress != null)
        | "\(.emailAddress)_\(.organizationUuid // "none" | .[0:8])" | gsub("[^[:alnum:]@._-]"; "_")' "$1" 2>/dev/null) || return 1
    printf '%s/%s.json\n' "$STORE" "$id"
}

# The file of the live account. Fails when nobody is signed in.
live_file() {
    jq -e "$SIGNED_IN" "$CREDENTIALS" >/dev/null 2>&1 || return 1
    account_file "$CONFIG"
}

# The name stays when the file exists. CREDENTIALS CONFIG FILE
store_account() {
    local name=""
    mkdir -p "$STORE"
    chmod 700 "$STORE"
    [ ! -f "$3" ] || name=$(jq -r '.name' "$3")
    jq -n --arg name "$name" --slurpfile credentials "$1" --slurpfile config "$2" \
        "{name: \$name, login: (\$credentials[0] | $PICK_LOGIN), oauthAccount: \$config[0].oauthAccount}" > "$3.tmp"
    mv "$3.tmp" "$3"
}

# The stored account, other than FILE, whose tokens are the live ones. Two accounts never share a token.
holder_of_live() {
    local live other
    live=$(fingerprint "$CREDENTIALS" "")
    for other in "$STORE"/*.json; do
        is_key "$other" && continue
        if [ "$other" != "$1" ] && [ "$(fingerprint "$other" .login)" = "$live" ]; then
            printf '%s\n' "$other"
            return 0
        fi
    done
    return 1
}

# Refresh tokens rotate, so the live login is saved before anything replaces it.
save_live() {
    local file
    file=$(live_file) || return 0
    store_account "$CREDENTIALS" "$CONFIG" "$file"
}

# A switch cut between its two renames, by a kill or a power cut, leaves the login of one account under
# the name of the other. Every command completes it before it saves the live login.
repair_live() {
    local file other
    file=$(live_file) || return 0
    other=$(holder_of_live "$file") || return 0
    lock_live
    apply_account "$other"
    release_locks
    read_account "$other"
    warn "A switch to $LABEL had been cut short, it is completed."
}

# NAME, EMAIL, PLAN and ENDS, the date the sign-in ends or "signed out". An empty name must stay a
# field, so no tab. PLAN is the plan as claude.ai names it: Max 20x is called Ultra since 30/10/2026,
# and claude still says max for it, telling it by the rate limit tier default_claude_max_20x. The plan
# and the tier of the profile, which claude fetches again at each start, come before the login's,
# which a token refresh leaves as it was.
read_account() {
    IFS=$'\x1f' read -r NAME EMAIL PLAN ENDS < <(jq -r 'if .kind == "key" then
        [.name, (.env.ANTHROPIC_BASE_URL // "gateway key"), "key", "-"] | join("\u001f") else
        [.name, .oauthAccount.emailAddress,
        (((.oauthAccount.organizationType | strings | select(startswith("claude_")) | ltrimstr("claude_")
            | select(. != "")) // .login.claudeAiOauth.subscriptionType // "-") as $plan
            | (.oauthAccount.organizationRateLimitTier // .login.claudeAiOauth.rateLimitTier) as $tier
            | if $plan == "max" and $tier == "default_claude_max_20x" then "ultra" else $plan end),
        (if .dead then "signed out" else ((.login.claudeAiOauth.refreshTokenExpiresAt // 0) / 1000 | floor
            | if . > 0 then strflocaltime("%d/%m/%Y") else "-" end) end)] | join("\u001f") end' "$1")
    LABEL=${NAME:-$EMAIL}
}

# The command that renews the account read last.
login_hint() {
    printf 'claude-switch login %q' "$LABEL"
}

# The file of the account called NAME, by name or email. Fails with 1 when none is, 2 when several are.
find_account() {
    local file found=()
    for file in "$STORE"/*.json; do
        if jq -e --arg who "$1" '.name == $who or .oauthAccount.emailAddress == $who' "$file" >/dev/null; then
            found+=("$file")
        fi
    done
    [ "${#found[@]}" -gt 0 ] || return 1
    [ "${#found[@]}" -eq 1 ] || return 2
    printf '%s\n' "${found[0]}"
}

# The same, or the reason it can't be chosen and an exit. NAME
require_account() {
    local status=0
    find_account "$1" || status=$?
    case $status in
        0) ;;
        2) die "Several accounts match $1. Name them in the prompt (r) and use the name." ;;
        *) die "No account called $1. Add it with: claude-switch login" ;;
    esac
}

# Prints what is wrong with a name for FILE, nothing when it's fine. NAME [FILE]
name_problem() {
    local other status=0
    case $1 in
        ""|-*|*[[:cntrl:]]*)
            printf 'A name must not be empty, start with - or hold control characters.'
            return 0
            ;;
        list|login|key|rename|refresh|help|auto|watch|hook)
            printf '%s is a command of this script, choose another name.' "$1"
            return 0
            ;;
        *[!0-9]*) ;;
        *)
            printf '%s can only be a number in the list, the prompt selects by number.' "$1"
            return 0
            ;;
    esac
    other=$(find_account "$1") || status=$?
    if [ "$status" -eq 2 ] || { [ "$status" -eq 0 ] && [ "$other" != "${2:-}" ]; }; then
        printf 'Another account is already called %s.' "$1"
    fi
}

set_name() {
    jq --arg name "$2" '.name = $name' "$1" > "$1.tmp"
    mv "$1.tmp" "$1"
}

# True when FILE is a gateway key account.
is_key() {
    jq -e '.kind == "key"' "$1" >/dev/null 2>&1
}

# True when the env of settings.json holds a gateway token, or the gateway key EXPR names (KEY_TOKEN by
# default). settings.json may be missing or empty. [EXPR]
key_in_settings() {
    jq -e -s "(.[0] // {}) | .env // {} | $KEY_SET | ${1:-$KEY_TOKEN} | length > 0" "$SETTINGS" >/dev/null 2>&1
}

# The key account whose gateway entries are those in the env of settings.json. A key is known by its
# credential, then by its URL, then by the rest, so entries changed by hand still name it, see
# save_live_key. Fails with 1 when no key is there, 2 when the token there is kept by no account, or by
# several that can't be told apart. Headers without a token fail with 1: claude takes no key from them
# before the login, and a proxy in front of claude.ai may want headers too. Tokens are compared inside
# jq, never printed.
live_key() {
    local file score best=0 found=()
    key_in_settings "$KEY_CREDENTIAL" || return 1
    for file in "$STORE"/*.json; do
        score=$(jq -r --slurpfile settings "$SETTINGS" "if .kind != \"key\" then 0 else
            (.env // {} | $KEY_SET) as \$key | (\$settings[0].env // {} | $KEY_SET) as \$live
            | if (\$key | $KEY_CREDENTIAL) != (\$live | $KEY_CREDENTIAL) then 0 elif \$key == \$live then 3
            elif \$key.ANTHROPIC_BASE_URL == \$live.ANTHROPIC_BASE_URL then 2 else 1 end end" "$file" 2>/dev/null) \
            || continue
        score=${score:-0}
        if [ "$score" -gt "$best" ]; then
            best=$score found=("$file")
        elif [ "$score" -eq "$best" ] && [ "$score" -gt 0 ]; then
            found+=("$file")
        fi
    done
    if [ "${#found[@]}" -eq 1 ]; then
        printf '%s\n' "${found[0]}"
        return 0
    fi
    key_in_settings || return 1
    return 2
}

# Gateway entries changed by hand in settings.json belong to the active key, as a rotated login belongs to
# its account, so they're saved to it before anything replaces them.
save_live_key() {
    local file
    file=$(live_key) || return 0
    if ! jq -e --slurpfile settings "$SETTINGS" "(.env | $KEY_SET) == (\$settings[0].env | $KEY_SET)" \
        "$file" >/dev/null; then
        jq --slurpfile settings "$SETTINGS" ".env = (\$settings[0].env | $KEY_SET)" "$file" > "$file.tmp"
        mv "$file.tmp" "$file"
    fi
}

# The account the next session starts on: a gateway key before the claude.ai login, as claude chooses,
# and none when that key is kept by no account.
active_file() {
    local file status=0
    file=$(live_key) || status=$?
    case $status in
        0) printf '%s\n' "$file" ;;
        1) live_file ;;
        *) return 1 ;;
    esac
}

# A switch replaces the token in settings.json, so one no account keeps stops it.
require_kept_key() {
    local status=0
    live_key >/dev/null || status=$?
    [ "$status" -ne 2 ] || die "~/.claude/settings.json holds a gateway key no account keeps, nothing changed." \
        "Keep it with: claude-switch key import NAME. To forget it, remove it after that with:" \
        "claude-switch key remove NAME"
}

# settings.json itself, behind the symbolic link a dotfiles manager may keep in its place.
settings_target() {
    readlink -f "$SETTINGS" 2>/dev/null || printf '%s\n' "$SETTINGS"
}

# Stops a switch before anything changes when settings.json can't be written aside, in a read-only store a
# dotfiles manager links it to for instance.
require_writable_settings() {
    local target
    target=$(settings_target)
    [ -w "${target%/*}" ] \
        || die "~/.claude/settings.json is $target, in a folder this user can't write, nothing changed."
}

# Writes settings.json from FILTER, a jq program run on what it holds, {} when it's missing or empty, with
# ARGS for jq. The rest of the file stays. It's written aside and renamed, since running sessions read it at
# any moment, with the mode, owner and group it had. FILTER [ARGS...]
write_settings() {
    local filter=$1 target source=/dev/null
    shift
    require_writable_settings
    target=$(settings_target)
    [ ! -s "$target" ] || source=$target
    WRITING=("$target.switch")
    jq -n --slurpfile settings "$source" "$@" "(\$settings[0] // {}) | $filter" \
        > "$target.switch" || die "~/.claude/settings.json can't be read as JSON, nothing changed."
    if [ ! -e "$target" ]; then
        mv "$target.switch" "$target"
    elif chmod --reference="$target" "$target.switch" && chown --reference="$target" "$target.switch" 2>/dev/null; then
        mv "$target.switch" "$target"
    else
        # An owner or a group this user can't give a file of its own: written in place, which keeps them.
        cat "$target.switch" > "$target"
        rm -f "$target.switch"
    fi
    WRITING=()
}

# Puts the entries of the key account FILE in the env of settings.json in place of the gateway entries
# there, or only empties those without FILE: an entry taken out stays as "", which claude takes as unset,
# so running sessions leave it too. The token never goes on a command line. A session keeps the
# ANTHROPIC_MODEL it started on, which is said. [FILE]
set_key_env() {
    local target source=/dev/null model new_model
    target=$(settings_target)
    [ ! -s "$target" ] || source=$target
    model=$(jq -r -s "(.[0] // {}) | .env // {} | $KEY_SET | .ANTHROPIC_MODEL // empty" "$source" 2>/dev/null || true)
    write_settings "((.env // {} | with_entries(if .key | IN($KEY_ENV[]) then .value = \"\" else . end))
        + (\$account[0].env // {})) as \$env | if \$env == {} then del(.env) else .env = \$env end" \
        --slurpfile account "${1:-/dev/null}"
    new_model=$(jq -r ".env // {} | $KEY_SET | .ANTHROPIC_MODEL // empty" "${1:-/dev/null}")
    if [ -n "$model" ] && [ "$model" != "$new_model" ]; then
        warn "A running session that started on the model $model keeps it: /model in it picks another."
    fi
}

switch_to_key() {
    local file=$1
    require_kept_key
    if [ "$(live_key || true)" = "$file" ]; then
        printf 'Already on %s.\n' "$LABEL"
        return 0
    fi
    set_key_env "$file"
    note_switch
    warn_environment "$file"
    remind_overrides "$file"
    printf 'Switched to %s, a gateway key. claude.ai in Chrome and Claude Desktop stay on their account.\n' "$LABEL"
}

# When the last switch happened, for automatic switching: a session that failed before it only has to send
# its request again.
note_switch() {
    [ ! -f "$AUTO_FLAG" ] || date +%s%3N > "$SWITCHED"
}

key_usage() {
    die "Usage: claude-switch key import NAME, key add NAME [--like KEY] [--api-key] [--base-url URL]" \
        "[--env VAR=VALUE]..., key renew NAME or key remove NAME"
}

# Sets TOKEN to a token asked without echo, or read from the standard input. The store is unlocked while
# someone types it. FOR
read_token() {
    TOKEN=""
    unlock_store
    if [ -t 0 ]; then
        read -rs -p "Gateway key for $1: " TOKEN || true
        printf '\n' >&2
    else
        IFS= read -r TOKEN || true
    fi
    lock_store
    TOKEN=$(trim "$TOKEN")
    [ -n "$TOKEN" ] || die "No key given, nothing changed."
}

# The key account with the same gateway entries as CANDIDATE, other than REPLACED: no switch could tell
# them apart. CANDIDATE [REPLACED]
key_twin() {
    local other
    for other in "$STORE"/*.json; do
        if [ "$other" != "${2:-}" ] && jq -e --slurpfile key "$1" \
            ".kind == \"key\" and (.env | $KEY_SET) == (\$key[0].env | $KEY_SET)" "$other" >/dev/null 2>&1; then
            printf '%s\n' "$other"
            return 0
        fi
    done
    return 1
}

# Puts FILE.tmp in place of the key account FILE, unless another account is the same key. FILE
store_key() {
    local twin
    if twin=$(key_twin "$1.tmp" "$1"); then
        rm -f "$1.tmp"
        read_account "$twin"
        die "The same gateway key is already kept as $LABEL, nothing changed."
    fi
    mv "$1.tmp" "$1"
}

# Keeps a gateway key as the account NAME: the one in settings.json (import), or a token asked without echo
# or read from the standard input (add). ACTION NAME [OPTIONS]
key_new() {
    local action=$1 name=$2 file problem held like="" like_name="" base="" api="" pair var
    local extra=()
    shift 2
    problem=$(name_problem "$name")
    [ -z "$problem" ] || die "$problem"
    file=$STORE/key_${name//[^[:alnum:]@._-]/_}.json
    [ ! -e "$file" ] || die "Another account is kept as ${file##*/}, choose another name."
    case $action in
        import)
            [ $# -eq 0 ] || key_usage
            key_in_settings "$KEY_CREDENTIAL" || die "The env of ~/.claude/settings.json holds no gateway key."
            if held=$(live_key); then
                read_account "$held"
                die "The gateway key in ~/.claude/settings.json is already kept as $LABEL."
            fi
            jq -s --arg name "$name" "{kind: \"key\", name: \$name, env: ((.[0] // {}) | .env // {} | $KEY_SET)}" \
                "$SETTINGS" > "$file.tmp"
            ;;
        add)
            while [ $# -gt 0 ]; do
                if [ "$1" = --api-key ]; then
                    api=yes
                    shift
                    continue
                fi
                [ $# -ge 2 ] || key_usage
                case $1 in
                    --like)
                        like=$(require_account "$2") || exit 1
                        like_name=$2
                        is_key "$like" || die "$2 is a claude.ai account, --like takes a gateway key."
                        ;;
                    --base-url) base=$2 ;;
                    --env)
                        pair=$2 var=${2%%=*}
                        [ "$pair" != "$var" ] && [ -n "${pair#*=}" ] || die "--env takes VAR=VALUE."
                        case $var in
                            ANTHROPIC_AUTH_TOKEN|ANTHROPIC_API_KEY) die "The token is asked, never given on the command line." ;;
                        esac
                        jq -en --arg var "$var" "\$var | IN($KEY_ENV[])" >/dev/null \
                            || die "$var is not an entry of a gateway key: $(jq -rn "$KEY_ENV | join(\", \")")"
                        extra+=("$pair")
                        ;;
                    *) key_usage ;;
                esac
                shift 2
            done
            read_token "$name"
            # The store was unlocked while the token was typed.
            problem=$(name_problem "$name")
            [ -z "$problem" ] || die "$problem"
            [ ! -e "$file" ] || die "Another account is kept as ${file##*/}, choose another name."
            [ -z "$like" ] || [ -f "$like" ] || die "$like_name is gone, nothing changed."
            # The token goes in the variable of the key it is like: a gateway that wants x-api-key refuses a
            # bearer token.
            CLAUDE_SWITCH_TOKEN=$TOKEN jq -n --arg name "$name" --arg base "$base" --arg api "$api" \
                --slurpfile like "${like:-/dev/null}" "(\$like[0].env // {} | $KEY_SET) as \$like_env
                | (if \$api != \"\" or (\$like_env.ANTHROPIC_API_KEY != null and \$like_env.ANTHROPIC_AUTH_TOKEN == null)
                    then \"ANTHROPIC_API_KEY\" else \"ANTHROPIC_AUTH_TOKEN\" end) as \$var
                | {kind: \"key\", name: \$name, env: ((\$like_env | del(.ANTHROPIC_AUTH_TOKEN, .ANTHROPIC_API_KEY))
                    + (if \$base == \"\" then {} else {ANTHROPIC_BASE_URL: \$base} end)
                    + {(\$var): env.CLAUDE_SWITCH_TOKEN})}" > "$file.tmp"
            for pair in "${extra[@]}"; do
                jq --arg var "${pair%%=*}" --arg value "${pair#*=}" '.env[$var] = $value' "$file.tmp" > "$file.tmp2"
                mv "$file.tmp2" "$file.tmp"
            done
            ;;
        *) key_usage ;;
    esac
    store_key "$file"
    printf 'Kept the gateway key %s. Switch to it with: claude-switch %q\n' "$name" "$name"
}

# A new token for the gateway key NAME, in the variable its token is in. Its URL and model names stay, and
# settings.json takes the new token too when NAME is the active key.
key_renew() {
    local file active=""
    file=$(require_account "$1") || exit 1
    is_key "$file" || die "$1 is a claude.ai account, renew it with: claude-switch login $(printf %q "$1")"
    read_account "$file"
    jq -e ".env | $KEY_SET | $KEY_TOKEN | length > 0" "$file" >/dev/null \
        || die "$LABEL has no token, its key is in its headers. Keep new headers with: claude-switch key import NAME"
    read_token "$LABEL"
    # The store was unlocked while the token was typed.
    [ -f "$file" ] || die "$LABEL is gone, nothing changed."
    [ "$(live_key || true)" != "$file" ] || active=yes
    CLAUDE_SWITCH_TOKEN=$TOKEN jq ".env |= if ($KEY_SET | .ANTHROPIC_AUTH_TOKEN) != null
        then .ANTHROPIC_AUTH_TOKEN = env.CLAUDE_SWITCH_TOKEN else .ANTHROPIC_API_KEY = env.CLAUDE_SWITCH_TOKEN end" \
        "$file" > "$file.tmp"
    store_key "$file"
    forget_refusal "$file"
    if [ -n "$active" ]; then
        set_key_env "$file"
        printf 'Renewed %s. Running sessions take the new token at their next request.\n' "$LABEL"
    else
        printf 'Renewed the gateway key %s.\n' "$LABEL"
    fi
}

# Forgets the gateway key NAME. The active key is emptied in settings.json first, as on a switch to the
# claude.ai login.
key_remove() {
    local file
    file=$(require_account "$1") || exit 1
    is_key "$file" || die "$1 is a claude.ai account. To forget it, remove ~/.claude-accounts/${file##*/}"
    read_account "$file"
    if [ "$(live_key || true)" = "$file" ]; then
        set_key_env
        rm -f "$file"
        printf 'Removed the gateway key %s, and emptied its entries in ~/.claude/settings.json.\n' "$LABEL"
    else
        rm -f "$file"
        printf 'Removed the gateway key %s.\n' "$LABEL"
    fi
}

# Keeps, renews or forgets a gateway key account. ACTION NAME [OPTIONS]
cmd_key() {
    local action=${1:-} name
    [ $# -ge 2 ] || key_usage
    name=$(trim "$2")
    shift 2
    case $action in
        import|add) key_new "$action" "$name" "$@" ;;
        renew)
            [ $# -eq 0 ] || key_usage
            key_renew "$name"
            ;;
        remove)
            [ $# -eq 0 ] || key_usage
            key_remove "$name"
            ;;
        *) key_usage ;;
    esac
}

# A new token or a new sign-in ends the wait a refused account was in. FILE
forget_refusal() {
    local stem=${1##*/}
    rm -f "$STORE/.usage/${stem%.json}.refused.json"
}

# One switch, sign-in or refresh at a time on the store. A refresh holds it while its folder has the
# login, so a switch never puts live a token that is being rotated.
lock_store() {
    mkdir -p "$STORE"
    chmod 700 "$STORE"
    exec 9>>"$STORE/.lock"
    if ! flock -n 9; then
        warn "Waiting for the background refresh of an account..."
        flock -w 300 9 || die "The accounts stayed locked for 5 minutes, nothing changed."
    fi
}

unlock_store() {
    exec 9>&-
}

# The locks claude takes itself, with mkdir. A holder touches its lock every 5 seconds, so one older
# than 15 is dead: claude auth status leaves them behind. Without these locks a session in the middle
# of a write brings the previous account back.
take_lock() {
    local path=$1 tries=0
    until mkdir "$path" 2>/dev/null; do
        if [ -n "$(find "$path" -maxdepth 0 -mmin +0.25 2>/dev/null)" ]; then
            rmdir "$path" 2>/dev/null || true
            continue
        fi
        tries=$((tries + 1))
        [ "$tries" -lt 200 ] || die "A running session holds $path, nothing changed. Try again."
        sleep 0.1
    done
    LOCKS+=("$path")
}

release_locks() {
    [ "${#LOCKS[@]}" -eq 0 ] || rmdir "${LOCKS[@]}" 2>/dev/null || true
    LOCKS=()
}

lock_live() {
    take_lock "$HOME/.claude/.oauth_refresh.lock"
    take_lock "$HOME/.claude.lock"
    take_lock "$CONFIG.lock"
}

# Puts FILE in place of the live login. Nothing but the account changes. Both files are written aside
# first and renamed after, since running sessions read them at any moment: a failure on the way leaves
# the previous account whole, never half a switch.
apply_account() {
    local stopped=""
    [ -f "$CREDENTIALS" ] || printf '{}\n' > "$CREDENTIALS"
    [ -f "$CONFIG" ] || printf '{}\n' > "$CONFIG"
    WRITING=("$CREDENTIALS.switch" "$CONFIG.switch")
    jq --slurpfile account "$1" "$DROP_LOGIN + \$account[0].login" "$CREDENTIALS" > "$CREDENTIALS.switch"
    jq --slurpfile account "$1" "$DROP_CACHES | .oauthAccount = \$account[0].oauthAccount" "$CONFIG" > "$CONFIG.switch"
    # A stop between the renames would leave the login of one account under the name of the other, so
    # it waits until both are done.
    trap 'stopped=1' TERM INT HUP
    mv "$CREDENTIALS.switch" "$CREDENTIALS"
    mv "$CONFIG.switch" "$CONFIG"
    WRITING=()
    trap 'exit 143' TERM INT HUP
    [ -z "$stopped" ] || exit 143
}

# A login a later claude keeps under a new key would stay behind on a switch, so it is announced.
check_login_keys() {
    local unknown
    unknown=$(jq -r "keys - [\"mcpOAuth\"] - $LOGIN_KEYS | join(\", \")" "$CREDENTIALS" 2>/dev/null || true)
    [ -z "$unknown" ] || warn "~/.claude/.credentials.json also holds $unknown, which a switch does not move."
}

# The variables a calling Claude Code session or an API key would pass on to claude, as env -u options.
claude_env() {
    local var
    CLEAN_ENV=()
    for var in $(compgen -e); do
        case $var in
            CLAUDE*|ANTHROPIC*) CLEAN_ENV+=(-u "$var") ;;
        esac
    done
}

# claude.ai in Chrome follows the switch, when the Chrome companion is installed. FILE
web_switch() {
    local account
    [ -x "$CHROME_HOST" ] || return 0
    account=$(jq -r '.oauthAccount.accountUuid // empty' "$1")
    [ -n "$account" ] || return 0
    "$CHROME_HOST" --switch "$account" 9>&- || warn "Switch claude.ai in Chrome by hand this time."
}

# claude.ai in Chrome back on the account Claude Code is on.
web_back() {
    local live
    WEB_AWAY=""
    live=$(live_file || true)
    [ -z "$live" ] || web_switch "$live"
}

# Claude Desktop follows the switch, when it is installed. It must be closed for that, so an open one is
# restarted: on a switch claude-switch makes by itself, and on one typed in a terminal unless it says no.
# FILE
desktop_switch() {
    local account status=0 answer=no
    [ -x "$DESKTOP_HELPER" ] || return 0
    account=$(jq -r '.oauthAccount.accountUuid // empty' "$1")
    [ -n "$account" ] || return 0
    "$DESKTOP_HELPER" switch "$account" 9>&- || status=$?
    [ "$status" -ne 6 ] || DESKTOP_KEPT=yes
    [ "$status" -eq 3 ] || return 0
    if [ -n "$AUTO" ]; then
        answer=yes
    elif [ -t 0 ] && [ -t 1 ]; then
        answer=""
        read -r -t 60 -p "Claude Desktop is open. Restart it on $LABEL? Code and Cowork tasks running in it stop. [Y/n] " \
            answer || printf '\n'
        answer=${answer:-yes}
    fi
    case $answer in
        y|Y|yes|Yes|YES) ;;
        *)
            printf 'Claude Desktop is open, so it stays on its account. Close it and run claude-switch %q to bring it along.\n' \
                "$LABEL"
            return 0
            ;;
    esac
    if ! "$DESKTOP_HELPER" quit 9>&-; then
        warn "Claude Desktop didn't close, it stays on its account."
        return 0
    fi
    # It was open before, so it opens again whatever the switch says.
    "$DESKTOP_HELPER" switch "$account" 9>&- || true
    "$DESKTOP_HELPER" start 9>&- || warn "Start Claude Desktop again by hand."
}

# The variables of this shell that a claude started from it takes before the account FILE. claude ranks a
# cloud provider, ANTHROPIC_AUTH_TOKEN, ANTHROPIC_API_KEY, then CLAUDE_CODE_OAUTH_TOKEN before the
# claude.ai login, and what settings.json sets, "" too, goes before the shell. CLAUDE_CONFIG_DIR takes
# another folder altogether.
warn_environment() {
    local var value
    [ -z "${CLAUDE_CONFIG_DIR:-}" ] \
        || warn "CLAUDE_CONFIG_DIR is set in this shell, a claude started from here doesn't follow the switch."
    for var in CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX CLAUDE_CODE_USE_FOUNDRY ANTHROPIC_AUTH_TOKEN \
        ANTHROPIC_API_KEY CLAUDE_CODE_OAUTH_TOKEN; do
        # The token of a key, and what claude ranks after it, doesn't count.
        ! jq -e --arg var "$var" '.env[$var] // "" | length > 0' "$1" >/dev/null 2>&1 || break
        value=${!var:-}
        case ${value,,} in
            ""|0|false|no|off) continue ;;
        esac
        jq -e -s --arg var "$var" '(.[0] // {}) | .env // {} | has($var)' "$SETTINGS" >/dev/null 2>&1 && continue
        warn "$var is set in this shell, a claude started from here doesn't follow the switch."
    done
}

# What settings.json sets that claude takes before the account FILE, ranked as claude ranks them: a cloud
# provider before everything, then a gateway token, then apiKeyHelper, CLAUDE_CODE_OAUTH_TOKEN and a
# profile named in ANTHROPIC_PROFILE, then the claude.ai login. A gateway key that sends only headers
# ranks with the login.
remind_overrides() {
    local rank=7 override
    read_account "$1"
    if is_key "$1"; then
        rank=$(jq -r ".env | $KEY_SET | if $KEY_TOKEN != \"\" then 2 else 7 end" "$1")
    fi
    override=$(jq -r -s --argjson rank "$rank" '(.[0] // {}) as $settings | ($settings.env // {}) as $vars
        | [(("CLAUDE_CODE_USE_BEDROCK", "CLAUDE_CODE_USE_VERTEX", "CLAUDE_CODE_USE_FOUNDRY")
                | select($vars[.] // "" | tostring | ascii_downcase | IN("", "0", "false", "no", "off") | not) | [1, .]),
            (select(($settings.apiKeyHelper // "") != "") | [4, "apiKeyHelper"]),
            ("CLAUDE_CODE_OAUTH_TOKEN" | select(($vars[.] // "") != "") | [5, .]),
            ("ANTHROPIC_PROFILE" | select(($vars[.] // "") != "") | [6, .])]
        | map(select(.[0] < $rank)) | first | .[1] // empty' "$SETTINGS" 2>/dev/null) || return 0
    [ -z "$override" ] || warn "~/.claude/settings.json sets $override, which claude uses before $LABEL."
}

switch_to() {
    local file=$1 ends key
    read_account "$file"
    if is_key "$file"; then
        switch_to_key "$file"
        return 0
    fi
    require_kept_key
    # The active key goes out of settings.json once the login is in place.
    key=$(live_key || true)
    [ -z "$key" ] || require_writable_settings
    if [ "$file" = "$(live_file || true)" ]; then
        if [ -n "$key" ]; then
            set_key_env
            note_switch
            warn_environment "$file"
            remind_overrides "$file"
            printf 'Switched to %s.\n' "$LABEL"
        else
            printf 'Already on %s.\n' "$LABEL"
        fi
        web_switch "$file"
        desktop_switch "$file"
        return 0
    fi
    if jq -e '.dead' "$file" >/dev/null; then
        die "$LABEL was signed out, nothing changed. Sign in again: $(login_hint)"
    fi
    ends=$(jq -r '.login.claudeAiOauth.refreshTokenExpiresAt // 0' "$file")
    if [ "$ends" -gt 0 ] && [ "$ends" -lt "$(date +%s%3N)" ]; then
        die "The login of $LABEL ended on $ENDS, nothing changed. Sign in again: $(login_hint)"
    fi
    lock_live
    save_live
    apply_account "$file"
    release_locks
    [ "$(live_file || true)" = "$file" ] || die "A running session wrote over the switch. Run it again."
    [ -z "$key" ] || set_key_env
    note_switch
    warn_environment "$file"
    remind_overrides "$file"
    check_login_keys
    printf 'Switched to %s.\n' "$LABEL"
    web_switch "$file"
    desktop_switch "$file"
}

# Signs in beside the store and not in ~/.claude, so the live account changes only on a switch.
# No session ever runs from this folder, it's gone when this ends.
cmd_login() {
    local file known="" answer problem wanted="" wanted_email=""
    if [ $# -ge 1 ] && [ "${1#-}" = "$1" ]; then
        wanted=$(require_account "$1") || exit 1
        ! is_key "$wanted" || die "$1 is a gateway key, it has no sign-in. Give it a new token with:" \
            "claude-switch key renew $(printf %q "$1")"
        shift
        read_account "$wanted"
        wanted_email=$EMAIL
        # The sign-in page uses the claude.ai session of the browser, so that session goes first. It
        # comes back however the sign-in ends.
        WEB_AWAY=yes
        web_switch "$wanted"
        set -- --email "$wanted_email" "$@"
    fi
    mkdir -p "$STORE"
    chmod 700 "$STORE"
    SIGNIN=$(mktemp -d "$STORE/.signin.XXXXXX")
    printf 'If the browser offers an account you already use here, switch it there or open the link in a private window.\n'
    claude_env
    env "${CLEAN_ENV[@]}" CLAUDE_CONFIG_DIR="$SIGNIN" claude auth login "$@" || die "The sign-in failed, nothing changed."
    jq -e "$SIGNED_IN" "$SIGNIN/.credentials.json" >/dev/null 2>&1 \
        && file=$(account_file "$SIGNIN/.claude.json") \
        || die "The sign-in returned, but it left no Claude login. Nothing changed."
    lock_store
    [ ! -f "$file" ] || known=yes
    store_account "$SIGNIN/.credentials.json" "$SIGNIN/.claude.json" "$file"
    forget_refusal "$file"
    read_account "$file"
    if [ -n "$wanted" ] && [ "$file" != "$wanted" ]; then
        warn "The browser signed in $EMAIL, not $wanted_email. $EMAIL is kept, $wanted_email is unchanged."
    fi
    [ -z "$WEB_AWAY" ] || web_back
    if [ -n "$known" ]; then
        if [ "$file" = "$(live_file || true)" ]; then
            lock_live
            apply_account "$file"
            release_locks
        fi
        printf '%s was already here, its login is renewed.\n' "$LABEL"
        return 0
    fi
    unlock_store
    if [ -t 0 ]; then
        while read -r -p "Name for this account (Enter to keep $EMAIL): " answer; do
            answer=$(trim "$answer")
            [ -n "$answer" ] || break
            problem=$(name_problem "$answer" "$file")
            if [ -z "$problem" ]; then
                lock_store
                set_name "$file" "$answer"
                unlock_store
                break
            fi
            printf '%s\n' "$problem"
        done
        read_account "$file"
    fi
    printf 'Added %s. Switch to it with: claude-switch %q\n' "$LABEL" "$LABEL"
}

rename_account() {
    local new problem
    new=$(trim "$2")
    problem=$(name_problem "$new" "$1")
    [ -z "$problem" ] || die "$problem"
    read_account "$1"
    set_name "$1" "$new"
    printf 'Renamed %s to %s.\n' "$LABEL" "$new"
}

hours() {
    printf '%d.%dh' $(($1 / 3600000)) $(($1 % 3600000 / 360000))
}

# A fingerprint of the tokens of every grant under PATH in FILE, never the tokens themselves. FILE PATH
fingerprint() {
    jq -c "[$2.claudeAiOauth, $2.designOauth, $2.cloudSessionsOauth] | map(.accessToken, .refreshToken)" "$1" \
        | md5sum | cut -d' ' -f1
}

# True when claude changed the tokens in STUB.
stub_moved() {
    [ "$(fingerprint "$1/.credentials.json" "" 2>/dev/null)" != "$(cat "$1/.base" 2>/dev/null)" ]
}

# A desktop notification, once a day for each KEY. One that could not be shown, at boot before the
# desktop is up for instance, is tried again on the next run. KEY TITLE BODY
notify_once() {
    local today
    today=$(date +%F)
    if grep -qxF "$1 $today" "$STORE/.notified" 2>/dev/null; then
        return 0
    fi
    command -v notify-send >/dev/null || return 0
    notify-send --app-name="Claude accounts" "$2" "$3" 9>&- 2>/dev/null || return 0
    { grep " $today\$" "$STORE/.notified" 2>/dev/null || true; printf '%s %s\n' "$1" "$today"; } > "$STORE/.notified.tmp"
    mv "$STORE/.notified.tmp" "$STORE/.notified"
}

# Runs claude on the folder STUB alone, never on ~/.claude: no update, no extra traffic, no
# connectors, and nothing of a calling Claude Code session or an API key in place of the login.
# STUB SECONDS ARGS...
stub_claude() {
    local stub=$1 seconds=$2
    shift 2
    claude_env
    (cd "$stub" && exec env "${CLEAN_ENV[@]}" CLAUDE_CONFIG_DIR="$stub" DISABLE_AUTOUPDATER=1 \
        CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 ENABLE_CLAUDEAI_MCP_SERVERS=false \
        timeout --foreground "$seconds" claude "$@") </dev/null >> "$stub/.out" 2>&1 9>&- || true
}

# Brings the login claude left in STUB back to its account, or says why not. Only while the account
# still holds the tokens STUB started from: a folder left by a killed run may be older than the store.
finish_stub() {
    local stub=$1 file account
    [ -d "$stub" ] || return 0
    file=$STORE/$(cat "$stub/.account" 2>/dev/null || true)
    if [ ! -f "$file" ] || [ "$(fingerprint "$file" .login)" != "$(cat "$stub/.base" 2>/dev/null)" ]; then
        rm -rf "$stub"
        return 0
    fi
    read_account "$file"
    if ! jq -e '.claudeAiOauth' "$stub/.credentials.json" >/dev/null 2>&1; then
        printf '%s: not refreshed, claude left no login\n' "$LABEL"
    elif jq -e '.claudeAiOauth | (.accessToken // "") == "" or (.refreshToken // "") == ""' \
        "$stub/.credentials.json" >/dev/null; then
        # claude empties the tokens when the server refuses the refresh. Only a new sign-in helps.
        jq --arg when "$(date +%d/%m/%Y)" '.dead = $when' "$file" > "$file.tmp"
        mv "$file.tmp" "$file"
        printf '%s: the login was refused, sign in again: %s\n' "$LABEL" "$(login_hint)"
        notify_once "dead:${file##*/}" "Claude account $LABEL is signed out" "Sign in again: $(login_hint)"
        DEAD=1
    elif ! stub_moved "$stub"; then
        printf '%s: not refreshed this time: %s\n' "$LABEL" "$(grep -v '^{' "$stub/.out" 2>/dev/null | head -1 || true)"
    else
        account=$(jq -c '.oauthAccount // null' "$stub/.claude.json" 2>/dev/null || echo null)
        jq --slurpfile credentials "$stub/.credentials.json" --argjson account "$account" \
            ".login = (\$credentials[0] | $PICK_LOGIN)
            | if \$account.accountUuid == .oauthAccount.accountUuid then .oauthAccount = \$account else . end" \
            "$file" > "$file.tmp"
        mv "$file.tmp" "$file"
        printf '%s: refreshed, access token good for %s\n' "$LABEL" \
            "$(hours $(( $(jq -r '.login.claudeAiOauth.expiresAt' "$file") - $(date +%s%3N) )))"
    fi
    rm -rf "$stub"
}

# Refreshes FILE in a folder of its own. FILE FORCE
refresh_account() {
    local file=$1 force=$2 now expires ends
    read_account "$file"
    if jq -e '.dead' "$file" >/dev/null; then
        printf '%s: signed out, sign in again: %s\n' "$LABEL" "$(login_hint)"
        notify_once "dead:${file##*/}" "Claude account $LABEL is signed out" "Sign in again: $(login_hint)"
        DEAD=1
        return 0
    fi
    now=$(date +%s%3N)
    ends=$(jq -r '.login.claudeAiOauth.refreshTokenExpiresAt // 0' "$file")
    if [ "$ends" -gt 0 ] && [ "$ends" -lt "$now" ]; then
        printf '%s: the sign-in ended on %s, sign in again: %s\n' "$LABEL" "$ENDS" "$(login_hint)"
        DEAD=1
        return 0
    fi
    expires=$(jq -r '.login.claudeAiOauth.expiresAt // 0' "$file")
    if [ "$force" = no ] && [ $((expires - now)) -gt "$REFRESH_AHEAD_MS" ]; then
        printf '%s: access token good for %s, nothing to do\n' "$LABEL" "$(hours $((expires - now)))"
        return 0
    fi
    STUB=$(mktemp -d "$STORE/.refresh.XXXXXX")
    printf '%s\n' "${file##*/}" > "$STUB/.account"
    fingerprint "$file" .login > "$STUB/.base"
    # An access token in the past makes claude refresh it first thing.
    jq --argjson past $((now - 60000)) ".login | $PICK_LOGIN | .claudeAiOauth.expiresAt = \$past" "$file" \
        > "$STUB/.credentials.json"
    jq '{oauthAccount, hasCompletedOnboarding: true}' "$file" > "$STUB/.claude.json"
    # claude auth status refreshes an expired login without a model request. The cheapest model is
    # the fallback, for a version where it no longer does.
    # Offline, claude retries without end: the timeouts keep a switch from waiting on it for long.
    stub_claude "$STUB" 60 auth status
    if ! stub_moved "$STUB"; then
        stub_claude "$STUB" 60 -p --model haiku --tools "" --strict-mcp-config --mcp-config '{"mcpServers":{}}' \
            --setting-sources local --no-session-persistence "Reply with exactly: OK"
    fi
    finish_stub "$STUB"
    STUB=""
}

# When the time MS comes, in days of the calendar here: today, tomorrow or in N days. From noon to noon,
# since a day is 23 or 25 hours long when the clock changes.
days_to() {
    local days
    days=$(( ($(date -d "$(date -d "@$(($1 / 1000))" +%F) 12:00" +%s) - $(date -d "12:00" +%s) + 43200) / 86400 ))
    case $days in
        0) printf 'today' ;;
        1) printf 'tomorrow' ;;
        *) printf 'in %d days' "$days" ;;
    esac
}

# What to do about the sign-in of FILE when it's over or ends within MS, nothing otherwise. FILE MS
signin_reminder() {
    local ends now
    read_account "$1"
    ends=$(jq -r '.login.claudeAiOauth.refreshTokenExpiresAt // 0' "$1")
    now=$(date +%s%3N)
    if jq -e '.dead' "$1" >/dev/null; then
        printf '%s is signed out. Sign in again: %s\n' "$LABEL" "$(login_hint)"
    elif [ "$ends" -le 0 ] || [ $((ends - now)) -ge "$2" ]; then
        return 0
    elif [ "$ends" -le "$now" ]; then
        printf 'The sign-in of %s ended on %s. Sign in again: %s\n' "$LABEL" "$ENDS" "$(login_hint)"
    else
        printf 'The sign-in of %s ends on %s, %s. Sign in again before then: %s\n' "$LABEL" "$ENDS" \
            "$(days_to "$ends")" "$(login_hint)"
    fi
}

remind_unkept_key() {
    local status=0
    live_key >/dev/null || status=$?
    [ "$status" -ne 2 ] || warn "~/.claude/settings.json holds a gateway key no account keeps, it goes before" \
        "the claude.ai login. Keep it with: claude-switch key import NAME"
}

# Only a new sign-in moves the date a sign-in ends, so that date is reminded of ahead of time.
remind_signins() {
    local file text
    for file in "$STORE"/*.json; do
        text=$(signin_reminder "$file" "$REMIND_AHEAD_MS")
        [ -z "$text" ] || warn "$text"
    done
}

# The same on the desktop, closer to the date. A refused login is announced by its refresh.
check_deadline() {
    local file=$1 text
    if jq -e '.dead' "$file" >/dev/null; then
        return 0
    fi
    text=$(signin_reminder "$file" "$WARN_AHEAD_MS")
    [ -n "$text" ] || return 0
    read_account "$file"
    printf '%s\n' "$text"
    notify_once "ends:${file##*/}" "Claude sign-in of $LABEL" "$text"
}

# A refresh killed once claude rotated a login leaves the new one in its folder, and the store's copy is
# used up. Every command brings it back first, a switch included.
recover_refreshes() {
    local stub
    for stub in "$STORE"/.refresh.*/; do
        finish_stub "${stub%/}"
    done
}

# Sign-in folders that outlived their sign-in, a killed or abandoned `login`: a finished one newer than
# the stored login of its account is kept, the rest goes. One younger than an hour may still be running.
tidy_signins() {
    local dir file ends stored
    for dir in "$STORE"/.signin.*/; do
        dir=${dir%/}
        [ -n "$(find "$dir" -maxdepth 0 -mmin +60 2>/dev/null)" ] || continue
        if jq -e "$SIGNED_IN" "$dir/.credentials.json" >/dev/null 2>&1 \
            && file=$(account_file "$dir/.claude.json"); then
            ends=$(jq -r '.claudeAiOauth.refreshTokenExpiresAt // 0' "$dir/.credentials.json")
            stored=$(jq -r '.login.claudeAiOauth.refreshTokenExpiresAt // 0' "$file" 2>/dev/null || echo 0)
            if [ "$ends" -gt "$stored" ]; then
                store_account "$dir/.credentials.json" "$dir/.claude.json" "$file"
                if [ "$file" = "$(live_file || true)" ]; then
                    lock_live
                    apply_account "$file"
                    release_locks
                fi
                read_account "$file"
                printf '%s: kept the sign-in an interrupted login left behind\n' "$LABEL"
            fi
            rm -rf "$dir"
        elif [ -n "$(find "$dir" -maxdepth 0 -mmin +1440 2>/dev/null)" ]; then
            rm -rf "$dir"
        fi
    done
}

# Refreshes the login of every account that is not live, and announces the sign-ins that end soon.
cmd_refresh() {
    local force=no file live
    case ${1:-} in
        "") ;;
        --force) force=yes ;;
        *) die "Usage: claude-switch refresh [--force]" ;;
    esac
    lock_store
    recover_refreshes
    tidy_signins
    unlock_store
    for file in "$STORE"/*.json; do
        # A gateway key has no login to refresh.
        is_key "$file" && continue
        lock_store
        live=$(live_file || true)
        # The live login belongs to the running sessions, its stored copy is older than theirs.
        if [ "$file" != "$live" ]; then
            refresh_account "$file" "$force"
        fi
        check_deadline "$file"
        unlock_store
    done
    [ "$DEAD" -eq 0 ]
}

auto_on() {
    [ -f "$AUTO_FLAG" ]
}

# A switch typed by hand holds its account while automatic switching is on, until that account runs out.
# FILE
hold_account() {
    auto_on || return 0
    printf '%s\n' "${1##*/}" > "$HOLD"
}

# A desktop notification of an automatic switch, when notify-send is there. TITLE BODY
notify() {
    command -v notify-send >/dev/null || return 0
    notify-send --app-name="Claude accounts" "$1" "$2" 9>&- 2>/dev/null || true
}

# True when settings.json holds a StopFailure hook of claude-switch.
hook_in_settings() {
    jq -e -s "(.[0] // {}) | [.hooks.StopFailure[]? | select($OWN_HOOK)] | length > 0" "$SETTINGS" >/dev/null 2>&1
}

# True when that hook is the one of this claude-switch, as set_auto_hook on writes it.
hook_current() {
    jq -e -s --arg command "$(printf '%q' "$SELF") hook" --arg matcher "$HOOK_MATCHER" '(.[0] // {})
        | [.hooks.StopFailure[]? | select(.matcher == $matcher and (.hooks | length) == 1
            and .hooks[0].command == $command and .hooks[0].asyncRewake == true)] | length > 0' \
        "$SETTINGS" >/dev/null 2>&1
}

# Adds the StopFailure hook of claude-switch to settings.json, or takes it out. Claude Code runs it in the
# background when a turn ends on a limit, and its exit 2 wakes the session. Other hooks stay. on|off
set_auto_hook() {
    if [ "$1" = on ]; then
        write_settings '.hooks = ((.hooks // {}) | .StopFailure = ([.StopFailure[]? | select('"$OWN_HOOK"' | not)]
            + [{matcher: $matcher, hooks: [{type: "command", command: $command, asyncRewake: true, timeout: 120}]}]))' \
            --arg matcher "$HOOK_MATCHER" --arg command "$(printf '%q' "$SELF") hook"
    else
        write_settings '.hooks.StopFailure |= map(select('"$OWN_HOOK"' | not))
            | if .hooks.StopFailure == [] then del(.hooks.StopFailure) else . end
            | if .hooks == {} then del(.hooks) else . end'
    fi
}

# The order the kinds of account rank in, as words: ultra key max by default.
auto_order() {
    local order
    order=$(head -n 1 "$ORDER_FILE" 2>/dev/null || true)
    printf '%s\n' "${order:-$DEFAULT_ORDER}"
}

# The same, as a person reads it.
order_text() {
    local kind words=()
    for kind in $(auto_order); do
        case $kind in
            ultra) words+=("Ultra subscriptions") ;;
            key) words+=("API and gateway keys") ;;
            max) words+=("Max and the other plans") ;;
        esac
    done
    local IFS=,
    printf '%s\n' "${words[*]-}" | sed 's/,/, then /g'
}

# Puts KIND... first, in that order, and the kinds left out after them in the default order. KIND...
set_auto_order() {
    local kind order=()
    for kind in "$@"; do
        kind=${kind,,}
        [ "$kind" != api ] || kind=key
        case $kind in
            ultra|key|max) ;;
            *) die "$kind is not a kind of account: ultra, max or key." ;;
        esac
        [[ " ${order[*]-} " != *" $kind "* ]] || die "$kind is twice in the order."
        order+=("$kind")
    done
    for kind in $DEFAULT_ORDER; do
        [[ " ${order[*]-} " == *" $kind "* ]] || order+=("$kind")
    done
    printf '%s\n' "${order[*]}" > "$ORDER_FILE"
}

# Turns automatic switching on or off, says how it stands, or sets the order. [on|off|order [KIND...]]
cmd_auto() {
    local active
    [ "${1:-}" = order ] || [ $# -le 1 ] || die "Usage: claude-switch auto [on|off|order [KIND...]]"
    case ${1:-} in
        "") auto_status ;;
        order)
            shift
            [ $# -le 3 ] || die "Usage: claude-switch auto order [KIND...], a KIND is ultra, max or key."
            if [ $# -eq 0 ]; then
                printf 'Automatic switching ranks the accounts in this order: %s.\n' "$(order_text)"
                return 0
            fi
            set_auto_order "$@"
            printf 'Automatic switching ranks the accounts in this order now: %s.\n' "$(order_text)"
            if auto_on && ! route; then
                printf 'No account has room now.\n'
            fi
            ;;
        on)
            [ -x "$USAGE_HELPER" ] || die "usage.py is not in ~/.local/share/claude-switch, run install.sh first."
            hook_current || set_auto_hook on
            : > "$AUTO_FLAG"
            rm -f "$HOLD"
            if ! systemctl --user enable --now "$WATCH_TIMER" >/dev/null 2>&1; then
                warn "$WATCH_TIMER didn't start, so only a limit a session meets switches. Start it with:" \
                    "systemctl --user enable --now $WATCH_TIMER"
            fi
            printf 'Automatic switching is on: the machine goes to the best account with room, every 5 minutes while a session is open and as soon as a session meets a limit.\n'
            if ! route; then
                printf 'No account has room now.\n'
            elif [ -z "$ROUTED_TO" ] && active=$(active_file); then
                read_account "$active"
                printf 'It stays on %s, the best account with room.\n' "$LABEL"
            fi
            ;;
        off)
            ! hook_in_settings || set_auto_hook off
            rm -f "$AUTO_FLAG" "$HOLD"
            systemctl --user disable --now "$WATCH_TIMER" >/dev/null 2>&1 || true
            printf 'Automatic switching is off.\n'
            ;;
        *) die "Usage: claude-switch auto [on|off|order [KIND...]]" ;;
    esac
}

auto_status() {
    local best held
    if ! auto_on; then
        printf 'Automatic switching is off. Turn it on with: claude-switch auto on\n'
        return 0
    fi
    printf 'Automatic switching is on: the machine goes to the best account with room, every 5 minutes while a session is open and as soon as a session meets a limit.\n'
    printf 'It ranks the accounts in this order: %s.\n' "$(order_text)"
    hook_in_settings || warn "~/.claude/settings.json lost the hook that moves a session on: claude-switch auto on puts it back."
    held=$STORE/$(head -n 1 "$HOLD" 2>/dev/null || true)
    if [ -f "$HOLD" ] && [ -f "$held" ]; then
        read_account "$held"
        printf '%s was chosen by hand, it stays until it runs out.\n' "$LABEL"
    fi
    "$USAGE_HELPER" read --timeout 5 "$STORE"/*.json 2>/dev/null || true
    if best=$("$USAGE_HELPER" best --order "$(auto_order | tr ' ' ,)" "$STORE"/*.json 2>/dev/null); then
        read_account "$best"
        printf 'The best account with room now is %s.\n' "$LABEL"
    else
        printf 'No account has room now.\n'
    fi
}

# Once a day at most: every account is out.
nothing_left() {
    local first
    first=$("$USAGE_HELPER" first "$STORE"/*.json 2>/dev/null) || first=""
    notify_once "nothing" "No Claude account has room" "${first:+The first to have room again: $first.}"
}

# Puts the machine on the best account that has room, when the active one isn't that account, and says
# so. ROUTED_TO and ROUTED_WHY tell where it went and why. Fails when no account has room.
route() {
    local active best hold="" why
    ROUTED_TO="" ROUTED_WHY=""
    active=$(active_file || true)
    # Younger than the 5 minutes between two runs of the timer, so each run reads.
    "$USAGE_HELPER" read --max-age 240 --timeout 10 "$STORE"/*.json 2>/dev/null || true
    if [ -f "$HOLD" ]; then
        hold=$STORE/$(head -n 1 "$HOLD")
        [ -f "$hold" ] || hold=""
    fi
    if ! best=$("$USAGE_HELPER" best ${hold:+--hold "$hold"} --order "$(auto_order | tr ' ' ,)" "$STORE"/*.json); then
        nothing_left
        return 1
    fi
    # A hold ends with its account's room.
    [ -z "$hold" ] || [ "$best" = "$hold" ] || rm -f "$HOLD"
    [ "$best" != "$active" ] || return 0
    read_account "$best"
    ROUTED_TO=$LABEL
    if [ -z "$active" ]; then
        why="no account was active"
    elif why=$("$USAGE_HELPER" why "$active"); then
        read_account "$active"
        why="$LABEL $why"
    else
        why="$ROUTED_TO is the best account with room"
    fi
    ROUTED_WHY=$why
    AUTO=yes
    switch_to "$best" >> "$AUTO_LOG" 2>&1
    AUTO=""
    printf 'Switched to %s: %s.\n' "$ROUTED_TO" "$ROUTED_WHY"
    notify "Switched to $ROUTED_TO" "$ROUTED_WHY.${DESKTOP_KEPT:+ Claude Desktop stays on its account: close it and run claude-switch $(printf '%q' "$ROUTED_TO") to bring it along.}"
}

# The log keeps its last lines once it passes 1 MB. Only before a run opens it: a run that writes to it would go
# on writing to the file the trim replaces.
trim_log() {
    [ "$(stat -c %s "$AUTO_LOG" 2>/dev/null || echo 0)" -gt 1048576 ] || return 0
    tail -n 2000 "$AUTO_LOG" > "$AUTO_LOG.$$" && mv "$AUTO_LOG.$$" "$AUTO_LOG"
}

# The timer runs this every 5 minutes. Without automatic switching or an open session it never gets here.
cmd_watch() {
    [ $# -eq 0 ] || die "Usage: claude-switch watch"
    trim_log
    route || true
}

# A session is woken 3 times in 10 minutes at most, so one every account refuses doesn't loop. SESSION
may_wake() {
    local now
    [ -n "$1" ] || return 0
    now=$(date +%s%3N)
    [ "$(awk -v since=$((now - 600000)) '$1 > since' "$STORE/.woken/$1" 2>/dev/null | wc -l)" -lt 3 ]
}

note_wake() {
    [ -n "$1" ] || return 0
    mkdir -p "$STORE/.woken"
    find "$STORE/.woken" -type f -mmin +1440 -delete 2>/dev/null || true
    date +%s%3N >> "$STORE/.woken/$1"
}

# When the request of the session failed, in milliseconds: the API error its transcript ends on, when that one is
# from the last minute, else a moment before this run started. TRANSCRIPT
failed_at() {
    local when=""
    if [ -f "$1" ]; then
        when=$(tail -n 50 "$1" | jq -r 'select(.isApiErrorMessage == true) | .timestamp // empty' 2>/dev/null | tail -n 1)
        # date takes an empty date for midnight.
        [ -z "$when" ] || when=$(date -d "$when" +%s%3N 2>/dev/null || true)
        [ -z "$when" ] || [ "$when" -gt $((STARTED - 60000)) ] || when=""
    fi
    printf '%s\n' "${when:-$((STARTED - 1500))}"
}

# Claude Code runs this when a turn ends on an API error, in the background, with the error on stdin. When
# the active account met a limit, the machine moves to the best account with room, and exit 2 wakes the
# session with a sentence on stderr for Claude, which sends its request again. claude-switch says the rest
# in ~/.claude-accounts/.auto.log, since Claude reads the hook's stderr.
cmd_hook() {
    local input error text reason session active switched message budget_words
    budget_words='budget|credit balance|insufficient_quota|spend limit'
    input=$(head -c 1048576 || true)
    auto_on || return 0
    error=$(jq -r '.error // empty' <<< "$input" 2>/dev/null || true)
    text=$(jq -r '[.last_assistant_message, .error_details] | map(strings) | join(" ")' <<< "$input" 2>/dev/null || true)
    case $error in
        rate_limit|billing_error|authentication_failed) reason=$error ;;
        unknown)
            # A gateway's budget comes back as an unknown error, only its words tell it.
            [[ ${text,,} =~ $budget_words ]] || return 0
            reason=budget
            ;;
        *) return 0 ;;
    esac
    session=$(jq -r '.session_id // empty' <<< "$input" 2>/dev/null | tr -cd '[:alnum:]-')
    may_wake "$session" || return 0
    active=$(active_file) || return 0
    switched=$(cat "$SWITCHED" 2>/dev/null || echo 0)
    if [ "${switched:-0}" -gt "$(failed_at "$(jq -r '.transcript_path // empty' <<< "$input" 2>/dev/null)")" ]; then
        # The machine moved after the request failed, by another session's hook or by hand.
        read_account "$active"
        message="claude-switch has moved this machine to $LABEL since the request failed."
    else
        "$USAGE_HELPER" refuse "$active" "$reason" "$text" >/dev/null || return 0
        # Nothing has room: Claude Code waits for the limit to reset by itself.
        route || return 0
        [ -n "$ROUTED_TO" ] || return 0
        message="claude-switch moved this machine to $ROUTED_TO: $ROUTED_WHY."
    fi
    # A session of Claude Desktop goes on with the login of Desktop, which only a restart of Desktop changes, and that
    # restart would end the session: woken, it would only meet the limit again.
    if [ -x "$DESKTOP_HELPER" ] && "$DESKTOP_HELPER" inside 9>&- 2>/dev/null; then
        printf 'The session runs in Claude Desktop, which keeps its account until it restarts: it is not woken.\n'
        return 0
    fi
    note_wake "$session"
    printf '%s The request that failed can go out again now: carry on with the task where it stopped.\n' "$message" >&3
    exit 2
}

# Brings the readings up to date and fills LEFT_OF with what each account has left.
read_left() {
    local file text
    LEFT_OF=()
    [ -x "$USAGE_HELPER" ] || return 0
    "$USAGE_HELPER" read --timeout 5 "$STORE"/*.json 2>/dev/null || true
    while IFS=$'\t' read -r file text; do
        LEFT_OF[$file]=$text
    done < <("$USAGE_HELPER" left "$STORE"/*.json 2>/dev/null || true)
}

cmd_list() {
    local file live marker
    live=$(active_file || true)
    read_left
    printf '  %-28s %-36s %-6s %-11s %s\n' ACCOUNT EMAIL PLAN UNTIL LEFT
    for file in "$STORE"/*.json; do
        read_account "$file"
        marker=" "
        [ "$file" != "$live" ] || marker="*"
        printf '%s %-28s %-36s %-6s %-11s %s\n' "$marker" "$LABEL" "$EMAIL" "$PLAN" "$ENDS" "${LEFT_OF[$file]:--}"
    done
    remind_unkept_key
    [ -z "$live" ] || remind_overrides "$live"
    remind_signins
}

# True when TEXT is the number of a row. TEXT ROWS
is_row() {
    [[ $1 =~ ^[1-9][0-9]{0,2}$ ]] && [ "$1" -le "$2" ]
}

prompt_rename() {
    local row=1 new
    if [ "${#files[@]}" -gt 1 ]; then
        read -r -p 'Rename which one (number)? ' row || return 0
        [ -n "$row" ] || return 0
        if ! is_row "$row" "${#files[@]}"; then
            printf 'There is no account %s.\n' "$row"
            return 0
        fi
    fi
    read -r -p 'New name (Enter to keep it): ' new || return 0
    [ -n "$(trim "$new")" ] || return 0
    (lock_store && rename_account "${files[row - 1]}" "$new") || true
}

# Asks whether the new account is a subscription or a key, then signs it in or keeps the key. Each runs as a
# claude-switch of its own, so a refusal ends that run and not the prompt.
prompt_add() {
    local kind name url problem
    printf '\n   s) A subscription, signed in with the browser\n   k) An API key or a gateway key\n\n'
    IFS= read -r -p 'Which kind of account? ' kind || return 0
    case $kind in
        s|S) bash "$0" login || true ;;
        k|K)
            read -r -p 'Name of the key: ' name || return 0
            name=$(trim "$name")
            [ -n "$name" ] || return 0
            problem=$(name_problem "$name")
            if [ -n "$problem" ]; then
                printf '%s\n' "$problem"
                return 0
            fi
            read -r -p 'Gateway URL (Enter for the Anthropic API): ' url || return 0
            url=$(trim "$url")
            if [ -z "$url" ]; then
                bash "$0" key add "$name" --api-key || true
            elif [[ ${url,,} == http://* || ${url,,} == https://* ]]; then
                bash "$0" key add "$name" --base-url "$url" || true
            else
                printf 'A gateway URL starts with https:// or http://.\n'
            fi
            ;;
        "") ;;
        *) printf 'Type s or k.\n' ;;
    esac
}

cmd_prompt() {
    local files file live shown here choice row when
    while :; do
        lock_store
        save_live
        save_live_key
        unlock_store
        live=$(active_file || true)
        files=("$STORE"/*.json)
        read_left
        row=0
        printf '\nClaude Code accounts\n\n'
        for file in "${files[@]}"; do
            row=$((row + 1))
            read_account "$file"
            shown=$LABEL
            [ "$LABEL" = "$EMAIL" ] || shown="$LABEL  $EMAIL"
            when="until $ENDS"
            [ "$ENDS" != "signed out" ] || when=$ENDS
            [ "$PLAN" != key ] || when=""
            here=""
            [ "$file" != "$live" ] || here="active"
            printf '  %2d) %-56s %-6s %-17s %-22s %s\n' "$row" "$shown" "$PLAN" "$when" "${LEFT_OF[$file]:--}" "$here"
        done
        remind_unkept_key
        [ -z "$live" ] || remind_overrides "$live"
        remind_signins
        printf '\n   a) Add an account\n   r) Rename an account\n   q) Quit\n\n'
        if ! read -r -p 'Select an account to switch to: ' choice; then
            printf '\n'
            return 0
        fi
        case $choice in
            q|Q) return 0 ;;
            a|A) prompt_add ;;
            r|R) prompt_rename ;;
            *)
                if is_row "$choice" "${#files[@]}"; then
                    lock_store
                    switch_to "${files[choice - 1]}"
                    hold_account "${files[choice - 1]}"
                    return 0
                fi
                printf 'Type a number from the list, a, r or q.\n'
                ;;
        esac
    done
}

case ${1:-} in
    help|-h|--help)
        usage
        exit 0
        ;;
    -*)
        usage >&2
        exit 2
        ;;
esac

command -v jq >/dev/null || die "jq is required."
command -v flock >/dev/null || die "flock is required."
command -v claude >/dev/null || die "claude is not in the PATH."

case ${1:-} in
    watch)
        # The timer runs this every 5 minutes: nothing to do without automatic switching or an open session.
        auto_on && [ -x "$USAGE_HELPER" ] && "$USAGE_HELPER" sessions || exit 0
        ;;
    hook)
        # Claude reads what the hook says: everything but its last sentence goes to the log.
        mkdir -p "$STORE"
        chmod 700 "$STORE"
        trim_log
        exec 3>&2 >>"$AUTO_LOG" 2>&1
        ;;
esac

lock_store
# What a switch killed on the way left aside. No other run writes there while the store is locked.
rm -f "$CREDENTIALS.switch" "$CONFIG.switch" "$(settings_target).switch"
recover_refreshes
repair_live
save_live
save_live_key

case ${1:-} in
    "")
        if [ -t 0 ] && [ -t 1 ]; then
            unlock_store
            cmd_prompt
        else
            cmd_list
        fi
        ;;
    list) cmd_list ;;
    login)
        shift
        unlock_store
        cmd_login "$@"
        ;;
    refresh)
        shift
        unlock_store
        cmd_refresh "$@"
        ;;
    key)
        shift
        cmd_key "$@"
        ;;
    rename)
        [ $# -eq 3 ] || die "Usage: claude-switch rename NAME NEW_NAME"
        file=$(require_account "$2") || exit 1
        rename_account "$file" "$3"
        ;;
    auto)
        shift
        cmd_auto "$@"
        ;;
    watch)
        shift
        cmd_watch "$@"
        ;;
    hook)
        shift
        cmd_hook "$@"
        ;;
    *)
        [ $# -eq 1 ] || die "Usage: claude-switch NAME"
        file=$(require_account "$1") || exit 1
        switch_to "$file"
        hold_account "$file"
        remind_signins
        ;;
esac
