{
  "manifest_version": 3,
  "name": "Claude account switch",
  "version": "1.1",
  "description": "Puts claude.ai on the account claude-switch switches to. It sees claude.ai only.",
  "key": "",
  "permissions": ["cookies", "nativeMessaging", "alarms", "declarativeNetRequest"],
  "host_permissions": ["https://claude.ai/*", "https://*.claude.ai/*"],
  "background": {
    "service_worker": "worker.js"
  }
}
